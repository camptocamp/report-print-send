    <field name="inherit_id" ref="pingen.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <field name="pingen_clientid" position="attributes">
        <attribute name="attrs" eval="False" />
      </field>
      <field name="pingen_client_secretid" position="attributes">
        <attribute name="attrs" eval="False" />
      </field>
      <field name="pingen_organization" position="attributes">
        <attribute name="attrs" eval="False" />
      </field>
      <field name="pingen_webhook_secret" position="attributes">
        <attribute name="attrs" eval="False" />
      </field>
      <field name="pingen_staging" position="attributes">
        <attribute name="attrs" eval="False" />
      </field>
    </field>
  </record>
</odoo>
