<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_wizard_import_zpl2_form" model="ir.ui.view">
        <field name="name">wizard.import.zpl2.form</field>
        <field name="model">wizard.import.zpl2</field>
        <field name="arch" type="xml">
            <form string="Import ZPL2">
                <group>
                    <group>
                        <field name="label_id" invisible="1" />
                        <field name="zpl_file" filename="zpl_filename" />
                        <field name="zpl_filename" invisible="1" />
                    </group>
                    <group>
                        <field name="delete_component" />
                    </group>
                </group>
                <footer>
                    <button
                        string="Import"
                        type="object"
                        name="import_zpl2"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
